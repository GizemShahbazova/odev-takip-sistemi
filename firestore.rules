rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function ownsClass(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    function isParent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }
    function linkedClass(classId) {
      return isParent()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(classId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(classId)).data.studentIds is list
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(classId)).data.studentIds.size() > 0;
    }
    function linkedStudent(classId, studentId) {
      return linkedClass(classId)
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(classId)).data.studentIds;
    }
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
      match /children/{classId} {
        allow get, list: if isParent() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }
    match /classes/{classId} {
      allow get: if (isTeacher() && resource.data.teacherId == request.auth.uid) || linkedClass(classId);
      allow list: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll(['name', 'teacherId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'teacherId', 'createdAt'])
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /assignments/{assignmentId} {
        allow get, list: if ownsClass(classId) || linkedClass(classId);
        allow create: if ownsClass(classId)
          && request.resource.data.keys().hasAll(['title', 'description', 'dueDate', 'createdAt'])
          && request.resource.data.keys().hasOnly(['title', 'description', 'dueDate', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.dueDate is string
          && request.resource.data.dueDate.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;

      }
      match /students/{studentId} {
        allow get: if ownsClass(classId) || linkedStudent(classId, studentId);
        allow list: if ownsClass(classId);
        allow create: if ownsClass(classId)
          && request.resource.data.keys().hasAll(['name', 'createdAt'])
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
        match /completions/{assignmentId} {
          allow get, list: if ownsClass(classId) || linkedStudent(classId, studentId);
          allow create, update: if ownsClass(classId)
            && exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId))
            && exists(/databases/$(database)/documents/classes/$(classId)/assignments/$(assignmentId))
            && request.resource.data.keys().hasAll(['status', 'completed', 'updatedBy', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['status', 'completed', 'updatedBy', 'updatedAt'])
            && request.resource.data.status in ['completed', 'pending', 'missing']
            && request.resource.data.completed is bool
            && request.resource.data.completed == (request.resource.data.status == 'completed')
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
      }
    }
  }
}
